# Senha do SQL Server (usuário sa). Sem aspas, ponto e vírgula ou espaços.
# Mínimo 8 caracteres com maiúscula, minúscula, número e símbolo.
SA_PASSWORD=
DB_NAME=AssistantSupport

# Portas publicadas no host (API e banco só via docker-compose.override.yml, para desenvolvimento)
WEB_PORT=8080
API_PORT=5000
DB_PORT=1433

# Limite de upload de PDF. Ao aumentar, ajuste client_max_body_size em web/nginx.conf.
UPLOAD_MAX_MB=10

# Aplica migrations ao subir a API
DB_AUTO_MIGRATE=true
# Popula exemplos se o banco estiver vazio (use false em produção)
DB_SEED=true

# Primeiro administrador. Criado só enquanto não existir nenhum admin no banco;
# depois disso, alterar estes valores não muda nada (use a tela de usuários).
# Senha com 8 a 128 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Duração da sessão (horas, renovada enquanto houver uso)
SESSION_HOURS=8
